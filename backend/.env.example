# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Kafe Dine-in Web POS"

# Database Configuration
# Local Docker: postgresql+asyncpg://pos_user:pos_password@localhost:5432/pos_cafe_db
# Test SQLite: sqlite+aiosqlite:///:memory:
DATABASE_URL=postgresql+asyncpg://pos_user:pos_password@localhost:5432/pos_cafe_db

# Security & Secrets (Ganti nilai ini di lingkungan produksi!)
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS Configuration (Domain frontend yang diizinkan, pisahkan koma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
